rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidSubmission() {
      return request.resource.data.formType is string
        && request.resource.data.read == false
        && request.resource.data.size() < 40;
    }

    match /submissions/{docId} {
      allow create: if isValidSubmission();
      // Only admins can read/update/delete — submissions contain PII
      // (including minors' names, DOB, and sibling data for enrollments).
      allow read, update, delete: if isAdmin();
    }
    match /programs/{docId} {
      allow read, write: if isAdmin();
    }
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /posts/{docId} {
      // Public can only see published posts; admins see drafts too.
      allow read: if (resource == null || resource.data.status == 'published') || isAdmin();

      // Admins can write anything.
      allow create, delete: if isAdmin();

      // Updates: admins can update any field. Public visitors can only
      // bump the `likes` counter by exactly 1 on a published post, and
      // touch no other fields.
      allow update: if isAdmin()
        || (
          resource.data.status == 'published'
          && request.resource.data.likes is number
          && request.resource.data.likes == (resource.data.get('likes', 0) + 1)
          // Every other field must be unchanged.
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        );
    }
    match /admin_users/{docId} {
      // Anyone signed in may read (needed to resolve their own role).
      // Only existing admins may write, so a new signup cannot self-promote.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /office_hours/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /coupons/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /email_broadcasts/{docId} {
      // Audit log of admin-sent broadcasts. Admins may review the history;
      // writes come only from the Cloud Function via the Admin SDK, which
      // bypasses these rules, so no client write is ever permitted.
      allow read: if isAdmin();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
